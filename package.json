{
  "name": "engineering-flow-platform-tests",
  "version": "1.0.0",
  "description": "Frontend automated tests for Engineering Flow Platform",
  "scripts": {
    "test": "jest",
    "test:unit": "jest tests/webchat/utils.test.js",
    "test:e2e": "npx playwright test tests/webchat/e2e.test.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {},
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "e2e.test.js"
    ],
    "collectCoverageFrom": [
      "src/gateway/static/js/**/*.js",
      "!src/gateway/static/js/webchat.js"
    ],
    "coverageDirectory": "coverage"
  }
}
