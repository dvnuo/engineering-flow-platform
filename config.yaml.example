# OpenClaw Mini Configuration Template
# COPY THIS FILE TO config.yaml AND FILL IN YOUR VALUES!

# ============================================
# Discord Configuration (REQUIRED)
# ============================================
discord:
  # Bot Token - Get from Discord Developer Portal
  # https://discord.com/developers/applications
  bot_token: "YOUR_DISCORD_BOT_TOKEN"
  
  # Channel ID - Enable Developer Mode in Discord, right-click channel → Copy ID
  channel_id: "YOUR_CHANNEL_ID"
  
  # Mode: "bot" (Bot API) or "webhook" (HTTP Webhook)
  # Bot API mode: Uses discord.py for real-time message handling
  # Webhook mode: Requires public URL for Discord webhooks
  mode: "bot"  # Recommended: use "bot" for simplicity

# ============================================
# LLM Configuration (REQUIRED)
# ============================================
llm:
  # Provider: openai, github_copilot, anthropic, custom
  provider: "openai"
  
  # OpenAI Configuration
  api_base: "https://api.openai.com/v1"
  api_key: "YOUR_OPENAI_API_KEY"
  model: "gpt-3.5-turbo"
  
  # Or GitHub Copilot Configuration
  # provider: "github_copilot"
  # api_base: "https://api.github.com/copilot"
  # api_key: "ghp_YOUR_GITHUB_TOKEN"
  # model: "gpt-4"
  
  max_tokens: 1000
  temperature: 0.7
  max_retries: 3
  retry_delay: 1

# ============================================
# Session Configuration (OPTIONAL)
# ============================================
session:
  max_history: 5  # Keep last 5 conversation turns

# ============================================
# Server Configuration (OPTIONAL)
# ============================================
server:
  host: "0.0.0.0"  # Listen on all interfaces
  port: 8000       # Default port

# ============================================
# Jira Configuration (OPTIONAL)
# ============================================
jira:
  enabled: false  # Set to true to enable Jira integration
  url: "https://your-domain.atlassian.net"
  username: "your-email@company.com"
  api_token: "${JIRA_API_TOKEN}"  # Use env var for security
  project: "PROJECT"  # Default project key

# ============================================
# Confluence Configuration (OPTIONAL)
# ============================================
confluence:
  enabled: false  # Set to true to enable Confluence integration
  url: "https://your-domain.atlassian.net/wiki"
  username: "your-email@company.com"
  api_token: "${CONFLUENCE_API_TOKEN}"  # Use env var for security
  space: "DEV"  # Default space key
