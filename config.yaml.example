# Engineering Flow Platform Configuration Template
# COPY THIS FILE TO config.yaml AND FILL IN YOUR VALUES!

# ============================================
# Discord Configuration (OPTIONAL)
# ============================================
# Discord is optional - set enabled: false to disable
# If not configured, the platform will run with HTTP API only
discord:
  # Enable Discord channel (optional - set to false to disable)
  enabled: false  # Set to true and configure below to enable Discord

  # Bot Token - Get from Discord Developer Portal
  # https://discord.com/developers/applications
  # Only required if enabled: true
  bot_token: ""  # Leave empty to disable Discord

  # Channel ID - Enable Developer Mode in Discord, right-click channel → Copy ID
  channel_id: ""

  # Mode: "bot" (Bot API) or "webhook" (HTTP Webhook)
  # Bot API mode: Uses discord.py for real-time message handling
  # Webhook mode: Requires public URL for Discord webhooks
  mode: "bot"  # Recommended: use "bot" for simplicity

# ============================================
# LLM Configuration (REQUIRED)
# ============================================
llm:
  # Provider: openai, github_copilot, anthropic, custom
  provider: "openai"
  
  # OpenAI Configuration
  api_base: "https://api.openai.com/v1"
  api_key: "YOUR_OPENAI_API_KEY"
  model: "gpt-3.5-turbo"
  
  # Or GitHub Copilot Configuration
  # provider: "github_copilot"
  # api_base: "https://api.github.com/copilot"
  # api_key: "ghp_YOUR_GITHUB_TOKEN"
  # model: "gpt-4"
  
  # Or Anthropic Claude Configuration
  # provider: "anthropic"
  # api_base: "https://api.anthropic.com/v1"
  # api_key: "${ANTHROPIC_API_KEY}"  # Set ANTHROPIC_API_KEY env var
  # model: "claude-sonnet-4-20250514"  # or claude-haiku-4-20250514, claude-opus-4-20250514
  
  max_tokens: 1000
  temperature: 0.7
  max_retries: 3
  retry_delay: 1

# ============================================
# Session Configuration (OPTIONAL)
# ============================================
# ============================================
# Session Configuration (OPTIONAL)
# ============================================
# Session persistence and caching settings
session:
  # In-memory session settings
  max_history: 5  # Keep last 5 conversation turns
  auto_save: true  # Automatically save sessions to disk

  # Persistence layer settings (JSONL format)
  persistence:
    enabled: true  # Enable session persistence
    storage_dir: "~/.efp/sessions"  # Where to store session files
    ttl_seconds: 86400  # Session TTL in seconds (default: 24 hours)
    max_file_size_mb: 100  # Max size before file rotation

  # Cache settings (for in-memory session cache)
  cache:
    enabled: true  # Enable session caching
    max_sessions: 1000  # Max sessions to keep in memory
    ttl_seconds: 3600  # Cache TTL in seconds (default: 1 hour)

# ============================================
# Memory Configuration (OPTIONAL)
# ============================================
# Long-term memory storage using SQLite with FTS5 full-text search

memory:
  enabled: true  # Enable memory storage
  provider: "openai"  # Embedding provider (openai, azure, local)
  model: "text-embedding-3-small"  # Embedding model

  # Hybrid search settings (vector + text)
  hybrid:
    enabled: true  # Enable hybrid search (vector + keyword)
    vector_weight: 0.7  # Weight for vector similarity (0.0-1.0)
    text_weight: 0.3  # Weight for keyword matching (0.0-1.0)

  # Cache settings
  cache:
    enabled: true  # Enable embedding cache
    max_entries: 50000  # Maximum cached embeddings

  # SQLite database location
  path: "~/.efp/memory"  # SQLite database location

# ============================================
# Workspace Configuration (OPTIONAL)
# ============================================
# Workspace paths for project-specific files
# All paths are unified under ~/.efp/ for easy backup

workspace:
  # Main workspace directory
  path: "~/.efp/workspace"

  # Memory subdirectory for daily notes
  memory_dir: "~/.efp/workspace/memory"

  # Session storage (can be overridden in session config)
  sessions_dir: "~/.efp/sessions"

# ============================================
# Session Storage Structure
# ============================================
# Session data is stored in ~/.efp/sessions/
#
# Structure:
#   ~/.efp/
#   ├── sessions/              ← Session JSONL files
#   │   ├── sessions.active.jsonl  (active sessions)
#   │   └── archive/               (rotated files)
#   ├── memory/                ← Memory SQLite DB
#   │   └── memories.sqlite
#   └── workspace/             ← Project-specific files
#       ├── MEMORY.md
#       └── memory/
#           └── YYYY-MM-DD.md
#
# All data is under ~/.efp/ for easy backup and management
# ============================================
# Server Configuration (OPTIONAL)
# ============================================
server:
  host: "0.0.0.0"  # Listen on all interfaces
  port: 8000       # Default port

# ============================================
# Jira Configuration (OPTIONAL)
# ============================================
# Jira supports multiple authentication methods:
# 1. Bearer Token (recommended for Jira Cloud)
# 2. Basic Auth with API Token (recommended for Jira Server/DC)
# 3. Basic Auth with Password (legacy, not recommended)

jira:
  enabled: false  # Set to true to enable Jira integration
  url: "https://your-domain.atlassian.net"
  project: "PROJECT"  # Default project key
  
  # --- Authentication Method 1: Bearer Token (Cloud) ---
  # Use this for Jira Cloud with API Token or OAuth
  # bearer_token: "${JIRA_BEARER_TOKEN}"
  
  # --- Authentication Method 2: Basic Auth with API Token (Server/DC) ---
  # API Token from: Jira Settings → Security → API tokens
  # username: "admin@company.com"
  # api_token: "${JIRA_API_TOKEN}"
  
  # --- Authentication Method 3: Basic Auth with Password (Legacy) ---
  # Not recommended, use API Token instead
  # username: "admin@company.com"
  # password: "${JIRA_PASSWORD}"
  
  # --- Advanced Options ---
  # API version: "2" (Server/DC) or "3" (Cloud, default)
  # api_version: "2"
  
  # Request timeout in seconds (default: 30)
  # timeout: 30.0

# ============================================
# Confluence Configuration (OPTIONAL)
# ============================================
confluence:
  enabled: false  # Set to true to enable Confluence integration
  url: "https://your-domain.atlassian.net/wiki"
  username: "your-email@company.com"
  api_token: "${CONFLUENCE_API_TOKEN}"  # Use env var for security
  space: "DEV"  # Default space key

# ============================================
# GitHub Configuration (OPTIONAL)
# ============================================
github:
  enabled: false  # Set to true to enable GitHub integration
  api_token: "${GITHUB_TOKEN}"  # GitHub Personal Access Token
  # Enterprise GitHub instance hostname (e.g., "github.company.com")
  # Used by gh (GitHub CLI) config - leave empty for github.com
  base_url: ""

# ============================================
# Mention Polling Configuration (OPTIONAL)
# ============================================
# Monitor @mentions across platforms and process commands
polling:
  enabled: false  # Set to true to enable mention polling

  # Polling interval in seconds (default: 30)
  interval_seconds: 30

  # Usernames to monitor (the configured account usernames)
  # When someone @mentions these users, the bot will process commands
  monitored_usernames:
    - "your-github-username"
    - "your-jira-username"
    - "your-confluence-username"

  # GitHub polling settings
  github:
    enabled: false
    repos:  # Repositories to monitor
      - "owner/repo1"
      - "owner/repo2"

  # Jira polling settings
  jira:
    enabled: false
    projects:  # Projects to monitor
      - "PROJECT1"
      - "PROJECT2"

  # Confluence polling settings
  confluence:
    enabled: false
    spaces:  # Spaces to monitor
      - "DEV"
      - "DOCS"

# ============================================
# SSH Configuration (OPTIONAL)
# ============================================
# Configure SSH key path for git operations (clone, push, pull)
# The key will be copied to ~/.ssh/ with proper permissions (600)
# Useful for Docker deployments where SSH key should not be baked in

ssh:
  enabled: false  # Set to true to enable SSH key setup
  private_key_path: ""  # Path to private key file (e.g., "/etc/engineering-flow-platform/id_ed25519")

# Example usage:
# ssh:
#   enabled: true
#   private_key_path: "/run/secrets/github_ssh_key"

# ============================================
# Git Configuration (OPTIONAL)
# ============================================
# Configure git user for commits
# These will be set via `git config --global` at startup

git:
  user:
    name: ""  # Git user name (e.g., "Engineering Flow Platform Bot")
    email: ""  # Git user email (e.g., "bot@company.com")

# Example usage:
# git:
#   user:
#     name: "Engineering Flow Platform Bot"
#     email: "bot@company.com"

# ============================================
# Heartbeat Configuration (OPTIONAL)
# ============================================
# Periodic background checks with thinking-level awareness
# The thinking level affects:
# - Check frequency: thinking=high (2x frequent), thinking=off (2x slower)
# - Detail level: thinking=high (detailed), thinking=off (simplified)

heartbeat:
  enabled: false  # Set to true to enable heartbeat checks
  check_interval: 300  # Base interval between checks in seconds (default: 5 minutes)

  # Example behavior:
  # - thinking=high: 2x more frequent (150s), detailed analysis
  # - thinking=off: 2x less frequent (600s), simplified checks

# Example usage:
# heartbeat:
#   enabled: true
#   check_interval: 300

# ============================================
# Debug Logging Configuration (OPTIONAL)
# ============================================
# Enable debug logging for troubleshooting
# Set log_level: DEBUG in logging configuration or use --debug flag

debug:
  enabled: false  # Set to true to enable debug logging

# Example usage:
# debug:
#   enabled: true

# What gets logged when enabled:
# - LLM requests: Model name, messages, tools
# - LLM responses: Content, reasoning, tool calls, usage
# - Agent processing: Messages, tool execution, final responses
